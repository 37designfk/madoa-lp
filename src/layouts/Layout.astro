---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'mail' | 'line';
}

const { title, description = '窓ガラスの割れ替えなら神戸のMADOA（株式会社三喜）。最短即日対応・適正価格・50年以上の実績で安心の施工をお届けします。', variant = 'mail' } = Astro.props;
const isLine = variant === 'line';
const base = import.meta.env.BASE_URL;
const isProduction = import.meta.env.SITE === 'https://lp.madoa.co.jp';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {!isProduction && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" as="image" type="image/webp" href={`${base}images/mainimage.webp`} />
    <title>{title}</title>
    {isProduction && <script src="https://dashboard.37d.jp/api/tag/madoa-lp" defer></script>}
    {isProduction && (
      <Fragment>
        <script is:inline>
          // 既知のAIクローラー・ボットはPixelを初期化しない
          var _botUA = /GPTBot|Claude-Web|anthropic-ai|cohere-ai|Meta-ExternalAgent|Bytespider|AhrefsBot|SemrushBot|PetalBot|DotBot|CCBot/i;
          if (!_botUA.test(navigator.userAgent)) {
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '971517092154665');
            fbq('track', 'PageView');
          }
        </script>
        <noscript>
          <img height="1" width="1" style="display:none"
            src="https://www.facebook.com/tr?id=971517092154665&ev=PageView&noscript=1"
          />
        </noscript>
      </Fragment>
    )}
  </head>
  <body class="font-sans text-gray-800 bg-white pb-16 md:pb-0">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-white shadow-sm">
      <div class="max-w-5xl mx-auto px-4 flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/" class="flex items-center">
          <div class="bg-primary-500 rounded px-3 py-1.5">
            <img src={`${base}images/logo.svg`} alt="MADOA" class="h-8" />
          </div>
        </a>
        <!-- Phone + CTA -->
        <div class="flex items-center gap-4">
          <a href="tel:078-597-2722" aria-label="電話で問い合わせ: 078-597-2722" class="flex items-center gap-2 text-primary-500 hover:text-primary-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            <span class="font-bold text-lg hidden sm:inline">078-597-2722</span>
          </a>
          {isLine ? (
            <a
              href="https://lin.ee/ctpgq59"
              target="_blank"
              rel="noopener"
              class="hidden md:inline-flex items-center gap-2 bg-[#06c755] hover:bg-[#05b04a] text-white font-bold px-5 py-2 rounded-full text-sm transition-all hover:scale-105"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.318v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
              LINEで相談
            </a>
          ) : (
            <a
              href="#contact"
              class="hidden md:inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-black font-bold px-5 py-2 rounded-full text-sm transition-all hover:scale-105"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              無料相談
            </a>
          )}
        </div>
      </div>
    </header>

    <slot />

    {isProduction && (
      <script is:inline>
        // gtag スタブ。タグローダー（dashboard.37d.jp）は gtag.js の読み込みと GA4 の config までは
        // 行うが window.gtag 自体は定義しないため、これが無いと下の gtag('event', ...) が
        // 毎回スキップされ GA4 のクリックイベントが 0 件になる（2026-07-25 実機検証で判明）
        window.dataLayer = window.dataLayer || [];
        if (typeof window.gtag !== 'function') {
          window.gtag = function(){ window.dataLayer.push(arguments); };
        }
        // クリック位置の推測（data-track-location 優先、なければ section id / 親要素から推測）
        function resolveLocation(el){
          var marked = el.closest('[data-track-location]');
          if (marked) return marked.getAttribute('data-track-location');
          if (el.closest('header')) return 'header';
          if (el.closest('footer')) return 'footer';
          var sec = el.closest('section');
          if (sec && sec.id) return sec.id;
          return 'unknown';
        }
        // UTM クエリ取得（初回訪問時のみ sessionStorage 保存、以降は同セッション内で再利用）
        function getUtmQuery(){
          try {
            var stored = sessionStorage.getItem('_lp_utm');
            if (stored) return stored;
            var qs = window.location.search || '';
            if (qs.indexOf('utm_') !== -1) {
              var params = new URLSearchParams(qs);
              var keep = new URLSearchParams();
              params.forEach(function(v,k){ if (k.indexOf('utm_') === 0 || k === 'gclid' || k === 'fbclid') keep.set(k,v); });
              var s = keep.toString();
              if (s) { sessionStorage.setItem('_lp_utm', s); return s; }
            }
          } catch(e) {}
          return '';
        }
        // LINE リンクへ UTM を引き継ぐ
        function appendUtm(url){
          var utm = getUtmQuery();
          if (!utm) return url;
          return url + (url.indexOf('?') === -1 ? '?' : '&') + utm;
        }
        document.addEventListener('click', function(e){
          var link = e.target && e.target.closest && e.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href') || '';
          var location = resolveLocation(link);
          if (href.indexOf('lin.ee') !== -1 || href.indexOf('line.me') !== -1) {
            // UTM 引き継ぎ（初回のみ書き換え、すでに utm_ が含まれていればスキップ）
            if (href.indexOf('utm_') === -1) {
              var newHref = appendUtm(href);
              if (newHref !== href) link.setAttribute('href', newHref);
            }
            if (window.gtag) gtag('event', 'click_line', { location: location });
            if (window.fbq) fbq('trackCustom', 'LineClick', { location: location });
          } else if (href.indexOf('tel:') === 0) {
            if (window.gtag) gtag('event', 'click_phone', { location: location });
            if (window.fbq) fbq('trackCustom', 'PhoneClick', { location: location });
          }
        });
        // フォーム送信完了（現状フォームなし、将来のフォーム設置時に発火）
        document.addEventListener('submit', function(){
          if (window.gtag) gtag('event', 'generate_lead');
          if (window.fbq) fbq('track', 'Lead', { content_name: 'Contact Form' });
        }, true);
      </script>
    )}
  </body>
</html>
