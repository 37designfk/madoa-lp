---
const base = import.meta.env.BASE_URL;
---

<section class="relative text-white overflow-hidden" data-track-location="hero">
  <div class="absolute inset-0">
    <img src={`${base}images/uchimado/photo-1.jpg`} alt="" class="w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-primary-800/75"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 py-20 md:py-32">
    <div class="text-center bg-black/50 backdrop-blur-sm rounded-3xl px-6 py-10 md:px-12 md:py-14">
      <!-- 補助金バッジ -->
      <div class="inline-flex items-center gap-2 bg-accent-500 text-gray-900 font-bold px-5 py-2 rounded-full mb-6 animate-fade-in-up text-sm md:text-base">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        先進的窓リノベ2026 補助金対応
      </div>

      <p class="text-primary-200 text-sm md:text-base mb-4 animate-fade-in-up">神戸の窓とドア専門店 MADOA（株式会社三喜）</p>

      <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-6 animate-fade-in-up animate-delay-200">
        内窓リフォームで<br />
        <span class="text-accent-400">最大100万円</span>の補助金
      </h1>
      <p class="text-lg md:text-xl text-primary-100 mb-4 animate-fade-in-up animate-delay-200">
        結露・寒さ・暑さ・騒音のお悩みを内窓で解決
      </p>
      <p class="text-base text-accent-300 font-bold mb-8 animate-fade-in-up animate-delay-200">
        補助金の申請手続きはすべてMADOAにおまかせ
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up animate-delay-300">
        <a
          href="tel:078-597-2722"
          class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-gray-900 font-bold py-4 px-8 rounded-full text-lg transition-all shadow-lg hover:shadow-xl hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          078-597-2722
        </a>
        <a
          href="https://lin.ee/ctpgq59"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-[#06c755] hover:bg-[#05b04a] text-white font-bold py-4 px-8 rounded-full text-lg transition-all shadow-lg hover:shadow-xl hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.318v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
          </svg>
          LINEで相談
        </a>
      </div>

      <div class="flex justify-center gap-4 mt-4 animate-fade-in-up animate-delay-400">
        <span class="inline-flex items-center gap-1 bg-white/15 backdrop-blur-sm text-white text-sm font-semibold py-1.5 px-4 rounded-full border border-white/20">見積無料</span>
        <span class="inline-flex items-center gap-1 bg-white/15 backdrop-blur-sm text-white text-sm font-semibold py-1.5 px-4 rounded-full border border-white/20">出張費無料</span>
        <span class="inline-flex items-center gap-1 bg-white/15 backdrop-blur-sm text-white text-sm font-semibold py-1.5 px-4 rounded-full border border-white/20">補助金申請代行</span>
      </div>

      <p class="text-primary-200 text-sm mt-4 animate-fade-in-up animate-delay-400">
        受付時間: 8:30〜17:30（土日祝休み）
      </p>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 80L60 73.3C120 66.7 240 53.3 360 46.7C480 40 600 40 720 46.7C840 53.3 960 66.7 1080 70C1200 73.3 1320 66.7 1380 63.3L1440 60V80H1380C1320 80 1200 80 1080 80C960 80 840 80 720 80C600 80 480 80 360 80C240 80 120 80 60 80H0Z" fill="white"/>
    </svg>
  </div>
</section>
