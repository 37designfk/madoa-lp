---
interface Props {
  variant?: 'mail' | 'line';
}
const { variant = 'mail' } = Astro.props;
const isLine = variant === 'line';
---

<section id="contact" class="bg-gradient-to-br from-primary-700 to-primary-900 py-16 md:py-24" data-track-location="cta-final">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center">
        <!-- Badge -->
        <div class="flex flex-wrap justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 bg-white/20 text-white text-sm font-bold px-4 py-1.5 rounded-full backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            お見積もり無料
          </span>
          <span class="inline-flex items-center gap-1.5 bg-white/20 text-white text-sm font-bold px-4 py-1.5 rounded-full backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            出張費無料
          </span>
          <span class="inline-flex items-center gap-1.5 bg-accent-500/90 text-white text-sm font-bold px-4 py-1.5 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            年間リフォーム実績700件
          </span>
        </div>

        <h2 class="text-2xl md:text-4xl font-bold text-white mb-4">
          まずはお気軽にご相談ください
        </h2>
        <p class="text-primary-100 text-lg mb-10 max-w-2xl mx-auto">
          窓のことなら何でもお任せください。専門スタッフが丁寧にご対応します。
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
          <a
            href="tel:078-597-2722"
            class={`inline-flex items-center gap-3 ${isLine ? 'bg-blue-600 hover:bg-blue-700' : 'bg-green-600 hover:bg-green-700'} text-white font-bold py-4 px-8 rounded-full text-lg transition-all shadow-lg hover:shadow-xl hover:scale-105 w-full sm:w-auto justify-center`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            078-597-2722
          </a>
          {isLine ? (
            <a
              href="https://lin.ee/ctpgq59"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-3 bg-[#06c755] hover:bg-[#05b04a] text-white font-bold py-4 px-8 rounded-full text-lg transition-all shadow-lg hover:shadow-xl hover:scale-105 w-full sm:w-auto justify-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.318v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
              LINEで無料相談する
            </a>
          ) : (
            <a
              href="https://madoa.co.jp/contact/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 bg-accent-500 hover:bg-accent-600 text-black font-bold py-4 px-8 rounded-full text-lg transition-all shadow-lg hover:shadow-xl hover:scale-105 w-full sm:w-auto justify-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
              </svg>
              メールで無料相談する
            </a>
          )}
        </div>

        <p class="text-primary-200 text-sm mb-2">
          受付時間: 8:30〜17:30（土日祝休み）
        </p>
        <p class="text-primary-200 text-sm mb-8">
          ※しつこい営業は一切いたしません
        </p>
    </div>

    <!-- Company info -->
    <div class="mt-10 pt-8 border-t border-white/20">
      <p class="text-primary-200 text-sm text-center">
        株式会社三喜 / 神戸で50年以上の実績 / 地域密着でサービスを提供しています
      </p>
    </div>
  </div>
</section>
