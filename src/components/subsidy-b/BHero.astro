---
const base = import.meta.env.BASE_URL;
---

<!--
  B案のファーストビュー。
  現行LPは写真・見出し・バッジ3つ・CTA2つをFVに詰めており、
  広告経由モバイルは平均10.6秒で離脱している（docs/tracking.md）。
  ここでは「読ませる」情報を削り、診断ボタンがスクロールせずに見える高さに収める。
-->
<section class="relative" data-track-location="hero">
  <div class="relative h-40 md:h-64 overflow-hidden">
    <img
      src={`${base}images/subsidy/case-bedroom-large.jpg`}
      alt="内窓リフォームの施工例"
      class="w-full h-full object-cover object-center"
      width="1024"
      height="768"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-primary-900/45"></div>
    <div class="absolute inset-0 flex items-center justify-center px-4">
      <p class="text-white text-sm md:text-base font-bold tracking-wide text-center drop-shadow">
        神戸の窓リフォーム専門 MADOA（株式会社三喜）
      </p>
    </div>
  </div>

  <div class="bg-primary-700 text-white px-4 pt-8 pb-10 text-center">
    <h1 class="text-2xl md:text-4xl font-bold leading-tight mb-4">
      窓の断熱リフォームに<br />
      <span class="text-accent-300 text-4xl md:text-6xl">最大100万円</span><br />
      の補助金が使えます
    </h1>
    <p class="text-white/85 text-sm md:text-base mb-7 leading-relaxed">
      先進的窓リノベ2026対応。<br class="md:hidden" />申請の手続きは、すべてこちらで行います。
    </p>

    <button
      type="button"
      data-diag-start="hero"
      class="w-full md:w-auto md:px-16 bg-accent-500 hover:bg-accent-600 text-gray-900 font-bold py-5 px-8 rounded-full text-lg md:text-xl transition-all shadow-lg hover:shadow-xl hover:scale-[1.02] hero-cta-pulse"
    >
      30秒で対象かチェックする
    </button>
    <p class="text-white/60 text-xs mt-3">
      3問に答えるだけ・無料・お名前の入力はありません
    </p>
  </div>
</section>

<style>
  @keyframes heroPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(252, 200, 0, 0.7);
    }
    50% {
      box-shadow: 0 0 0 12px rgba(252, 200, 0, 0);
    }
  }
  .hero-cta-pulse {
    animation: heroPulse 2s infinite;
  }
</style>
