---
interface Props {
  variant?: 'mail' | 'line';
}
const { variant = 'mail' } = Astro.props;
const isLine = variant === 'line';
const testimonials = [
  {
    comment:
      '夜中に窓が割れてパニックでしたが、翌朝一番で来てくれました。見積もりもその場で出してくれて、午前中には新しいガラスに。対応の速さに驚きました。',
    name: 'K.S.様',
    area: '神戸市東灘区',
    tag: '戸建て',
  },
  {
    comment:
      '他社では見積もりに1週間かかると言われましたが、MADOAさんは翌日には見積もり、3日で施工完了。費用も他社より2割ほど安かったです。',
    name: 'M.T.様',
    area: '神戸市中央区',
    tag: 'マンション',
  },
  {
    comment:
      'マンションの高層階でしたが、管理組合への手続きも含めてすべて対応いただけました。追加費用も一切なく、最初の見積もり通りでした。',
    name: 'Y.H.様',
    area: '神戸市灘区',
    tag: 'マンション',
  },
  {
    comment:
      '子供が窓にボールをぶつけてしまい、慌てて電話。すぐに仮養生に来てくれて、翌日には交換完了。本当に助かりました。',
    name: 'A.N.様',
    area: '芦屋市',
    tag: '戸建て',
  },
  {
    comment:
      '割れたガラスの交換をきっかけに、ついでに内窓も提案いただき補助金も活用できました。最大100万円の制度を分かりやすく説明してくれて、結果的に光熱費まで下がっています。',
    name: 'T.K.様',
    area: '神戸市西区',
    tag: '補助金活用',
  },
  {
    comment:
      '夜遅くに窓が割れて困っていたところ、翌朝すぐに来ていただき、その日のうちに新品同様に。神戸で50年やっているという安心感もあり、近所にも勧めています。',
    name: 'R.S.様',
    area: '神戸市垂水区',
    tag: '緊急対応',
  },
];
const base = import.meta.env.BASE_URL;
---

<section id="testimonials" class="bg-gray-50 py-16 md:py-24" data-track-location="testimonials">
  <div class="max-w-5xl mx-auto px-4">
    <!-- Voice photo decoration -->
    <div class="flex justify-center mb-8">
      <figure class="text-center">
        <picture>
          <source srcset={`${base}images/top-img-voice.webp`} type="image/webp" />
          <img
            src={`${base}images/top-img-voice.png`}
            alt="実際にご利用いただいたお客様とそのご家族"
            class="max-w-xs md:max-w-sm rounded-xl shadow-lg mx-auto"
            loading="lazy"
            width="970"
            height="500"
          />
        </picture>
        <figcaption class="text-gray-500 text-sm mt-3">
          実際にご利用いただいたお客様とそのご家族
        </figcaption>
      </figure>
    </div>

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">お客様の声</h2>
      <p class="text-gray-600 text-lg mb-6">ご利用いただいたお客様からの声をご紹介します</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <div class="inline-flex items-center gap-3 bg-white rounded-full shadow-md px-6 py-3">
          <span class="text-sm font-semibold text-gray-700">Google口コミ平均</span>
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>
          <span class="text-2xl font-bold text-gray-900">4.8</span>
        </div>
        <div class="inline-flex items-center gap-3 bg-white rounded-full shadow-md px-6 py-3">
          <span class="text-sm font-semibold text-gray-700">LIXIL窓本舗</span>
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>
          <span class="text-2xl font-bold text-gray-900">4.9</span>
          <span class="text-xs text-gray-500">42件以上</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {testimonials.map((item) => (
        <div class="bg-white rounded-xl shadow-md p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex gap-0.5">
              {[...Array(5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              ))}
            </div>
            <span class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-full">
              {item.tag}
            </span>
          </div>
          <p class="text-gray-700 leading-relaxed mb-6">{item.comment}</p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center">
              <span class="text-primary-700 font-bold text-sm">{item.name.charAt(0)}</span>
            </div>
            <div>
              <p class="font-semibold text-gray-900 text-sm">{item.name}</p>
              <p class="text-gray-500 text-xs">{item.area}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-gray-500 mt-8">
      Googleクチコミ および LIXIL窓本舗 三喜ストアに寄せられた42件以上のレビューより一部抜粋。掲載は許諾済みのものに限ります。
    </p>

    <!-- Mini CTA -->
    <div class="text-center mt-12">
      <p class="text-gray-700 font-semibold mb-4">あなたも安心の施工を体験しませんか？</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="tel:078-597-2722"
          class={`inline-flex items-center justify-center gap-2 ${isLine ? 'bg-[#0080c4] hover:bg-[#0073ad]' : 'bg-green-600 hover:bg-green-700'} text-white font-bold px-6 py-3 rounded-full transition-all hover:scale-105 text-sm`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          今すぐ電話する
        </a>
        {isLine ? (
          <a
            href="https://lin.ee/ctpgq59"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 bg-[#06c755] hover:bg-[#05b04a] text-white font-bold px-6 py-3 rounded-full transition-all hover:scale-105 text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.318v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            LINEで相談する
          </a>
        ) : (
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-black font-bold px-6 py-3 rounded-full transition-all hover:scale-105 text-sm"
          >
            無料で相談する
          </a>
        )}
      </div>
    </div>
  </div>
</section>
