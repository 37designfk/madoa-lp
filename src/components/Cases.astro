---
interface Props {
  variant?: 'mail' | 'line';
}
const { variant = 'mail' } = Astro.props;
const isLine = variant === 'line';
const base = import.meta.env.BASE_URL;
const cases = [
  {
    title: '店舗ガラスドア割れ替え',
    description: '強化ガラス 5mm / 店舗入口',
    detail: '店舗入口のガラスドアを新しい強化ガラスに交換。クリアな仕上がりで防犯性も向上しました。',
    image: 'images/case-door.webp',
    imageAlt: '店舗ガラスドア割れ替えの施工写真',
  },
  {
    title: '掃き出し窓ガラス割れ替え',
    description: '透明ガラス 5mm / 掃き出し窓',
    detail: '和室の掃き出し窓のガラスを交換。透明度の高い新しいガラスで明るい室内を取り戻しました。',
    image: 'images/case-sliding.webp',
    imageAlt: '掃き出し窓ガラス割れ替えの施工写真',
  },
  {
    title: '腰高窓ガラス割れ替え',
    description: '透明ガラス 3mm / 腰高窓',
    detail: 'マンションの腰高窓のガラスを交換。きれいなガラスで見通しも良くなりました。',
    image: 'images/case-window.webp',
    imageAlt: '腰高窓ガラス割れ替えの施工写真',
  },
];
---

<section id="cases" class="bg-white py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">施工事例</h2>
      <p class="text-gray-600 text-lg">実際の施工事例をご紹介します</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {cases.map((item) => (
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
          <picture>
            <source srcset={`${base}${item.image}`} type="image/webp" />
            <img
              src={`${base}${item.image.replace('.webp', '.png')}`}
              alt={item.imageAlt}
              loading="lazy"
              width="1200"
              height="654"
              class="w-full h-48 object-cover"
            />
          </picture>
          <div class="p-5">
            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-primary-600 font-medium mb-2">{item.description}</p>
            <p class="text-sm text-gray-600 leading-relaxed">{item.detail}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mini CTA -->
    <div class="text-center mt-12 bg-primary-50 rounded-xl p-8">
      <p class="text-gray-800 font-bold text-lg mb-2">あなたの窓も、きれいに直ります。</p>
      <p class="text-gray-600 text-sm mb-5">まずは無料でお見積もり。お気軽にご連絡ください。</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="tel:078-597-2722"
          class={`inline-flex items-center justify-center gap-2 ${isLine ? 'bg-[#0080c4] hover:bg-[#0073ad]' : 'bg-green-600 hover:bg-green-700'} text-white font-bold px-6 py-3 rounded-full transition-all hover:scale-105 text-sm`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          078-597-2722
        </a>
        {isLine ? (
          <a
            href="https://lin.ee/ctpgq59"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 bg-[#06c755] hover:bg-[#05b04a] text-white font-bold px-6 py-3 rounded-full transition-all hover:scale-105 text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.318v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            LINEで相談する
          </a>
        ) : (
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-black font-bold px-6 py-3 rounded-full transition-all hover:scale-105 text-sm"
          >
            無料で相談する
          </a>
        )}
      </div>
    </div>
  </div>
</section>
